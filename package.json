{
  "name": "deepseekbot-site",
  "version": "0.0.0",
  "private": true,
  "description": "deepseekbot.botharness.ai — the DeepSeekBot product site",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "oxlint",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "verify": "pnpm format:check && pnpm lint && pnpm build",
    "deploy": "pnpm build && wrangler deploy",
    "deploy:preview": "pnpm build && wrangler versions upload",
    "frames": "node scripts/frame-svg.mjs"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.6.5",
    "@astryxdesign/theme-neutral": "^0.6.5",
    "@botharness/pixel-avatar": "^0.1.0",
    "@botharness/pixel-morph": "^0.2.0",
    "@fontsource/fusion-pixel-12px-proportional-sc": "^5.3.0",
    "@stylexjs/stylex": "^0.19.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.6.5",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "subset-font": "^2.9.0",
    "typescript": "7.0.2",
    "vite": "^8.3.2",
    "wrangler": "^4.147.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.4.2"
}
